# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Codex review scratch files (codex-plan-review / codex-build-review write these to the repo root)
.codex-plan-review.md
.codex-plan-review-result.md
.codex-build-review.diff
.codex-build-review-uncommitted.diff
.codex-build-review-result.md
.codex-build-review-tests.txt
